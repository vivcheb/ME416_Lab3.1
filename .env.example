# ==============================================================================
# Room Activity Tracker — Environment Configuration
# Copy to .env and populate real values. NEVER commit .env to version control.
# ==============================================================================

# 5MP PoE IP Camera RTSP sub-stream URL (server-side only; credentials are masked in logs/UI)
# URL-encode special characters in the password (e.g., @ -> %40, : -> %3A)
# Manufacturer path examples (verify in your camera manual):
#   Reolink:  /h264Preview_01_sub
#   Hikvision: /Streaming/Channels/102
#   Dahua:    /cam/realmonitor?channel=1&subtype=1
CAMERA_RTSP_URL=rtsp://VIEW_USER:VIEW_PASS@192.168.1.100:554/h264Preview_01_sub

# Optional 5MP main-stream URL for high-res display mode (downscaled server-side to <=1280px)
CAMERA_MAIN_RTSP_URL=

# FFmpeg inference stream settings
STREAM_FPS=15
STREAM_WIDTH=640

# Optional explicit path to ffmpeg binary (defaults to system ffmpeg in PATH)
FFMPEG_PATH=

# MQTT Broker settings (QoS 0, retained publishes, LWT offline)
BROKER_HOST=rasticvm.internal
BROKER_PORT=1883
BROKER_FALLBACK=false
TOPIC=room/activity/status

# Server binding (use 127.0.0.1 for local-only, 0.0.0.0 for LAN/preview)
PORT=3000
HOST=127.0.0.1

# Publish retained {"room_status":"offline","reason":"tab_closed"} after WebSocket grace period
OFFLINE_ON_TAB_CLOSE=true
OFFLINE_GRACE_MS=5000

# Optional access token required on /stream.mjpg, /ws, and /api/* when exposed on LAN
ACCESS_TOKEN=

# AI Studio platform defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
